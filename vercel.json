{
  "version": 2,
  "name": "cloudfolio",
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api/analytics.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/analytics", "dest": "/api/analytics.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
